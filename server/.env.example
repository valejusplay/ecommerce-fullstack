# Copiar este archivo como .env y completar los valores reales.
# El .env nunca se versiona: esta excluido en el .gitignore de la raiz.

# --- Servidor ---
PORT=5000
NODE_ENV=development

# URL del frontend, para la politica de CORS.
# En produccion: la URL del proyecto en Vercel.
CLIENT_URL=http://localhost:5173

# --- Base de datos ---
# Cadena de conexion de MongoDB Atlas (cluster M0).
MONGODB_URI=

# --- Autenticacion ---
# Cadena larga y aleatoria. Firma los JWT que viajan en la cookie httpOnly.
JWT_SECRET=

# --- Cloudinary (imagenes de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (verificacion de cuenta via Nodemailer) ---
# EMAIL_APP_PASSWORD es la contrasena de aplicacion de Gmail, no la del correo.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- MercadoPago ---
# Credencial de prueba (sandbox), obtenida en el panel de desarrolladores.
MP_ACCESS_TOKEN=
